# Raw pictures downloaded by arithmetic-odyssey/tools/Get-DinoPictures.ps1.
# Third-party art with unclear licenses; this repository is public.
downloaded-pictures/

# Player saves and backups exported from the game
*-backup-*.json

# OS files
.DS_Store
Thumbs.db

# Local preview of the published site (node .github/scripts/assemble-site.mjs)
_site/

# Built from each theme's files by arithmetic-odyssey/tools/build-storyline.mjs
# (the deploy workflow and the local server build it)
arithmetic-odyssey/themes/*/storyline.json

# The offline app's service worker, built with its file list by
# arithmetic-odyssey/tools/build-offline.mjs (the deploy workflow and the local
# server build it, so uploaded pictures are always in the list)
arithmetic-odyssey/sw.js
